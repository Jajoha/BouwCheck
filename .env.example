# ─────────────────────────────────────────────────────────────
# BouwCheck — voorbeeldconfiguratie
# Kopieer naar .env.local. Zet hier NOOIT echte geheimen in dit voorbeeldbestand.
# Zonder enige configuratie draait BouwCheck in de lokale demo-modus.
# ─────────────────────────────────────────────────────────────

# PostgreSQL-verbinding. Op Vercel: Storage → Create Database → Neon → koppel aan dit project;
# Vercel zet DATABASE_URL (gepoold) en DATABASE_URL_UNPOOLED dan automatisch. POSTGRES_URL werkt ook.
# Leeg laten = lokale demo-database (PGlite) in ./.data/pglite, automatisch gevuld met demo-data.
DATABASE_URL=
# Directe verbinding voor migraties (Neon zet deze zelf). Leeg = DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Maximaal aantal databaseverbindingen per serverproces (alleen bij DATABASE_URL).
DATABASE_POOL_SIZE=5

# Demo-modus: demo-inlogknoppen, demo-verzending van offerteaanvragen en zichtbare demo-banner.
# Standaard AAN zonder DATABASE_URL en UIT met DATABASE_URL. Zet expliciet op false in productie.
DEMO_MODE=

# Map voor lokale data (PGlite-database en geüploade bijlagen).
# Leeg = .data lokaal, of /tmp/bouwcheck op Vercel/serverless (tijdelijk!).
BOUWCHECK_DATA_DIR=

# Vercel Blob (privé) voor foto's en bijlagen. Op Vercel: Storage → Create → Blob (kies 'Private')
# → koppel aan dit project; Vercel zet deze variabele automatisch. Leeg = lokale map (op Vercel tijdelijk).
BLOB_READ_WRITE_TOKEN=

# Preview-deploys migreren de database alleen als dit 'true' is (zet aan als Neon per preview
# een eigen databasebranch maakt). Productie-deploys migreren altijd.
MIGRATE_ON_PREVIEW=

# Publieke basis-URL. Bij https worden sessiecookies als 'Secure' gemarkeerd.
APP_URL=http://localhost:3000

# Alleen voor `npm run db:create-admin`: wachtwoord van de nieuwe beheerder (min. 12 tekens).
# ADMIN_PASSWORD=

# ── AI-intake (Claude) ───────────────────────────────────────
# API-sleutel van Anthropic. Alleen server-side; zet hem in Vercel → Settings → Environment Variables.
# Leeg = AI-analyse uitgeschakeld; gebruikers kunnen de werkzaamheden dan zelf invullen.
ANTHROPIC_API_KEY=
# Model (standaard claude-opus-5-5). Bij een onbekend model rekent het verbruik met het hoogste bekende tarief.
ANTHROPIC_MODEL=
# Denkinspanning: low | medium | high | xhigh | max (standaard medium). Hoger = grondiger, duurder en trager.
AI_EFFORT=
# Maximaal AI-verbruik per account per kalendermaand in USD (standaard 5).
AI_MONTHLY_LIMIT_USD=
# Maximaal aantal AI-analyses per account per uur (standaard 10).
AI_HOURLY_LIMIT=
# Maximaal aantal foto's per analyse (standaard 8).
AI_MAX_PHOTOS=

# ── Registercontrole (openbare registers) ────────────────────
# Gebruikt dezelfde ANTHROPIC_API_KEY. Webzoekopdrachten kosten extra ($10 per 1.000).
# Geheim voor de geplande dagelijkse controle (Vercel Cron, zie vercel.json). Leeg = geplande controle uit;
# handmatig controleren via Beheer → Registers blijft werken. Vercel stuurt dit geheim zelf mee.
CRON_SECRET=
# Aantal uitvoerders per geplande run (1–5, standaard 2).
REGISTER_CRON_BATCH=

# ── E-mail (Resend) ──────────────────────────────────────────
# Alle mails gaan eerst naar de outbox (Beheer → E-mail). Zonder beide variabelen worden ze niet
# verstuurd en krijgen ze de status 'niet geconfigureerd'. EMAIL_FROM moet op een bij Resend
# geverifieerd domein staan, bijv. "BouwCheck <check@jouwdomein.nl>".
RESEND_API_KEY=
EMAIL_FROM=
# Optioneel antwoordadres.
EMAIL_REPLY_TO=
# Geplande mails (opvolgreeks) worden dagelijks verstuurd door /api/cron/e-mail; vereist CRON_SECRET.

# ── Feature flags (standaard uit) ────────────────────────────
# Offertecheck-funnel (/offertecheck, rapporten, beheer).
FEATURE_OFFERTECHECK=
# Founding members (/founding-members en het blok op de homepage).
FEATURE_FOUNDING_MEMBERS=
# Terugbetaalbare aanbetaling voor founding members (pas na akkoord bouwen).
FEATURE_DEPOSIT_PAYMENTS=

# ── Offertecheck ─────────────────────────────────────────────
# Maximale AI-kosten voor alle Offertechecks samen per dag in USD (standaard 25). Daarboven blijft een
# check op 'ingediend' staan; een beheerder kan de analyse handmatig starten.
OFFERTECHECK_DAILY_BUDGET_USD=
# Maximaal aantal checks per e-mailadres per 24 uur (standaard 3).
OFFERTECHECK_MAX_PER_EMAIL=
# Optionele agendalink op de bedankpagina (bijv. Calendly of een Google-afsprakenpagina). Leeg = geen knop.
OFFERTECHECK_AGENDA_URL=
