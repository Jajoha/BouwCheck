# ─────────────────────────────────────────────────────────────
# BouwCheck — voorbeeldconfiguratie
# Kopieer naar .env.local. Zet hier NOOIT echte geheimen in dit voorbeeldbestand.
# Zonder enige configuratie draait BouwCheck in de lokale demo-modus.
# ─────────────────────────────────────────────────────────────

# PostgreSQL-verbinding (bijv. Supabase → Project Settings → Database → Connection string).
# Leeg laten = lokale demo-database (PGlite) in ./.data/pglite, automatisch gevuld met demo-data.
# Voorbeeld Supabase (transaction pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Maximaal aantal databaseverbindingen per serverproces (alleen bij DATABASE_URL).
DATABASE_POOL_SIZE=5

# Demo-modus: demo-inlogknoppen, demo-verzending van offerteaanvragen en zichtbare demo-banner.
# Standaard AAN zonder DATABASE_URL en UIT met DATABASE_URL. Zet expliciet op false in productie.
DEMO_MODE=

# Map voor lokale data (PGlite-database en geüploade bijlagen).
# Leeg = .data lokaal, of /tmp/bouwcheck op Vercel/serverless (tijdelijk!).
BOUWCHECK_DATA_DIR=

# Publieke basis-URL. Bij https worden sessiecookies als 'Secure' gemarkeerd.
APP_URL=http://localhost:3000

# Alleen voor `npm run db:create-admin`: wachtwoord van de nieuwe beheerder (min. 12 tekens).
# ADMIN_PASSWORD=

# ── AI-intake (Claude) ───────────────────────────────────────
# API-sleutel van Anthropic. Alleen server-side; zet hem in Vercel → Settings → Environment Variables.
# Leeg = AI-analyse uitgeschakeld; gebruikers kunnen de werkzaamheden dan zelf invullen.
ANTHROPIC_API_KEY=
# Model (standaard claude-opus-5-5). Bij een onbekend model rekent het verbruik met het hoogste bekende tarief.
ANTHROPIC_MODEL=
# Denkinspanning: low | medium | high | xhigh | max (standaard medium). Hoger = grondiger, duurder en trager.
AI_EFFORT=
# Maximaal AI-verbruik per account per kalendermaand in USD (standaard 5).
AI_MONTHLY_LIMIT_USD=
# Maximaal aantal AI-analyses per account per uur (standaard 10).
AI_HOURLY_LIMIT=
# Maximaal aantal foto's per analyse (standaard 8).
AI_MAX_PHOTOS=
